# CallScreen AI (.env.example)

# App Environment
PORT=3000
NODE_ENV=development

# CALL-E Configuration
# Set to 'false' to enable live outbound PSTN calling
CALLE_MOCK_MODE=true

# CALL-E Auth & Telemetry
CALLE_SOURCE=skills_sh
CALLE_INTEGRATION=skills_sh_skill
CALLE_INTEGRATION_VERSION=0.1.0

# Optional API Keys for LLM extraction (if using direct AI provider fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Devpost / Codex MCP Auth (if connecting via Devpost MCP)
DEVPOST_AUTH_TOKEN=
